#!/bin/bash
# Secret store for MCP servers backed by the iCloud keychain.
#
# Items: service = claude-mcp, account = variable/secret name, all flagged
# kSecAttrSynchronizable, i.e. synchronized between Macs on the same Apple ID.
# They are reached through ~/bin/keychain-icloud (see the comment in it for why
# that is a python script rather than /usr/bin/security or a compiled binary).
set -uo pipefail

KC="$HOME/bin/keychain-icloud"
VARS_FILE="${MCP_SECRETS_VARS:-$HOME/.config/mcp-secrets/vars}"
# File secrets (json keys, OAuth tokens) — a launcher materializes them into a
# temporary file instead of an environment variable.
FILES_FILE="${MCP_SECRETS_FILES:-$HOME/.config/mcp-secrets/files}"

die() { echo "mcp-secrets: $*" >&2; exit 1; }

[ -x "$KC" ] || die "helper $KC is missing"

vars_list() {
  [ -f "$VARS_FILE" ] || die "no variable list file: $VARS_FILE"
  grep -vE '^\s*(#|$)' "$VARS_FILE"
}

files_list() {
  [ -f "$FILES_FILE" ] || return 0
  grep -vE '^\s*(#|$)' "$FILES_FILE"
}

kc_get()  { "$KC" get "$1" 2>/dev/null; }
kc_has()  { "$KC" has "$1" 2>/dev/null; }
# the value goes through stdin, so it never shows up in the process list
kc_set()  { printf '%s' "$2" | "$KC" set "$1" >/dev/null 2>&1; }

add_to_list() {
  local file="$1" name="$2"
  grep -qxF "$name" "$file" 2>/dev/null || printf '%s\n' "$name" >> "$file"
}

cmd_list() {
  local v val
  while read -r v; do
    if val=$(kc_get "$v") && [ -n "$val" ]; then
      printf '%-26s in the iCloud keychain (%d chars)\n' "$v" "${#val}"
    else
      printf '%-26s MISSING\n' "$v"
    fi
  done < <(vars_list)
  local first=1
  while read -r v; do
    [ -n "$v" ] || continue
    if [ $first -eq 1 ]; then echo "— file secrets (materialized by a launcher):"; first=0; fi
    if val=$(kc_get "$v") && [ -n "$val" ]; then
      printf '%-26s in the iCloud keychain (%d bytes)\n' "$v" "${#val}"
    else
      printf '%-26s MISSING\n' "$v"
    fi
  done < <(files_list)
}

# Besides readability this checks the accessibility class: an item that is not
# AfterFirstUnlock reads fine during the day, but at night with the screen locked
# it fails the whole dump (-25308) — hence FAIL rather than a mere note.
cmd_check() {
  local v val cls rc=0 classes
  classes=$("$KC" classes 2>/dev/null)
  while read -r v; do
    cls=$(printf '%s\n' "$classes" | awk -F'\t' -v n="$v" '$1 == n { print $2 }')
    if ! val=$(kc_get "$v") || [ -z "$val" ]; then
      printf '%-26s FAIL\n' "$v"; rc=1
    elif [ "$cls" != "ck" ]; then
      printf '%-26s FAIL class %s, needs ck=AfterFirstUnlock — unreadable at night (%d)\n' "$v" "${cls:-?}" "${#val}"; rc=1
    else
      printf '%-26s ok (%d)\n' "$v" "${#val}"
    fi
  done < <(cat <(vars_list) <(files_list))
  [ $rc -eq 0 ] || echo "mcp-secrets: problems found; a wrong accessibility class is fixed by 'mcp-secrets migrate-accessible'" >&2
  return $rc
}

cmd_get() {
  [ $# -eq 1 ] || die "usage: mcp-secrets get NAME"
  kc_has "$1" || die "$1 is not in the keychain"
  "$KC" get "$1"
  echo
}

cmd_set() {
  [ $# -eq 1 ] || die "usage: mcp-secrets set VAR"
  local val
  printf 'Value for %s (input hidden): ' "$1" >&2
  read -rs val
  echo >&2
  [ -n "$val" ] || die "empty value, nothing written"
  kc_set "$1" "$val" || die "cannot write $1"
  add_to_list "$VARS_FILE" "$1"
  echo "mcp-secrets: $1 written (${#val} chars)" >&2
}

cmd_delete() {
  [ $# -eq 1 ] || die "usage: mcp-secrets delete NAME"
  "$KC" delete "$1" || die "$1 is not in the keychain"
  echo "mcp-secrets: $1 deleted (the name stays in the list)" >&2
}

# Prints `export VAR='...'` lines for eval — in a single keychain round-trip.
cmd_export() {
  local wanted; wanted=$(vars_list)
  [ -n "$wanted" ] || return 0
  local dumpfile rc=0
  dumpfile=$(mktemp "${TMPDIR:-/tmp}/mcp-secrets-dump.XXXXXX") || die "cannot create a temporary file"
  chmod 600 "$dumpfile"
  trap 'rm -f "$dumpfile"' EXIT
  # The helper's stderr is not silenced: without it the reason (e.g. "keychain is
  # locked", OSStatus -25308 with the screen locked) is invisible in nightly logs.
  if ! "$KC" dump > "$dumpfile"; then
    # dump is one SecItemCopyMatching over every item of the service, and macOS
    # returns -25308 for the whole request if a single item is unreadable with the
    # screen locked (WhenUnlocked class). The rest are still available, so we pick
    # them up one by one: a nightly job gets live tokens, and the log names
    # exactly the items that caused it.
    echo "mcp-secrets: dump failed, reading items one by one" >&2
    : > "$dumpfile"
    local v val
    while read -r v; do
      if val=$("$KC" get "$v" 2>/dev/null | base64); then
        printf '%s\t%s\n' "$v" "$val" >> "$dumpfile"
      fi
    done <<< "$wanted"
    # Mention the accessibility class only when it is actually to blame.
    local bad
    bad=$("$KC" classes 2>/dev/null | awk -F'\t' '$2 != "ck" { print $1 }' | tr '\n' ' ')
    [ -z "$bad" ] || echo "mcp-secrets: not AfterFirstUnlock (fix with 'mcp-secrets migrate-accessible'): $bad" >&2
  fi
  /usr/bin/python3 -c '
import base64, shlex, sys
wanted = set(sys.argv[1].split())
found = {}
for line in open(sys.argv[2]):
    line = line.rstrip("\n")
    if "\t" not in line:
        continue
    name, blob = line.split("\t", 1)
    if name in wanted:
        found[name] = base64.b64decode(blob).decode("utf-8", "replace")
for name in sys.argv[1].split():
    if name in found:
        print("export %s=%s" % (name, shlex.quote(found[name])))
missing = [n for n in sys.argv[1].split() if n not in found]
if missing:
    sys.stderr.write("mcp-secrets: missing or unreadable: %s\n" % " ".join(missing))
    # Non-zero exit, otherwise the caller (the claude shim, a nightly job) cannot
    # tell a full set of secrets from an empty one and silently starts with empty
    # tokens.
    sys.exit(1)
' "$wanted" "$dumpfile" || rc=1
  rm -f "$dumpfile"
  trap - EXIT
  return $rc
}

# --- file secrets ---

cmd_set_file() {
  [ $# -eq 2 ] || die "usage: mcp-secrets set-file NAME FILE"
  local name="$1" file="$2"
  [ -f "$file" ] || die "no such file: $file"
  "$KC" set "$name" < "$file" >/dev/null 2>&1 || die "cannot write $name"
  add_to_list "$FILES_FILE" "$name"
  echo "mcp-secrets: $name written from $file ($(wc -c <"$file" | tr -d ' ') bytes)" >&2
}

cmd_get_file() {
  [ $# -ge 1 ] && [ $# -le 2 ] || die "usage: mcp-secrets get-file NAME [OUTFILE]"
  local name="$1" out="${2:-}"
  kc_has "$name" || die "$name is not in the keychain"
  if [ -n "$out" ]; then
    ( umask 077; "$KC" get "$name" > "$out" ) || die "cannot write $out"
  else
    "$KC" get "$name"
  fi
}

# --- one-off migration from the file-based login.keychain ---

cmd_migrate() {
  local service="claude-mcp" name old new n=0 skipped=0
  echo "mcp-secrets: moving items from login.keychain to the iCloud keychain" >&2
  while read -r name; do
    [ -n "$name" ] || continue
    old=$(security find-generic-password -w -s "$service" -a "$name" 2>/dev/null) || {
      echo "  $name — not in login.keychain, skipped" >&2; skipped=$((skipped+1)); continue
    }
    # file secrets were stored in login.keychain as base64 — keep them raw here
    if files_list | grep -qxF "$name"; then
      printf '%s' "$old" | base64 -d | "$KC" set "$name" >/dev/null 2>&1 \
        || die "cannot move $name"
      new=$("$KC" get "$name" | base64)
    else
      printf '%s' "$old" | "$KC" set "$name" >/dev/null 2>&1 || die "cannot move $name"
      new=$("$KC" get "$name")
    fi
    if [ "$new" = "$old" ]; then
      security delete-generic-password -s "$service" -a "$name" >/dev/null 2>&1
      echo "  $name — moved, old item deleted" >&2
      n=$((n+1))
    else
      die "$name: value mismatch after the move, the old item was kept"
    fi
  done < <(cat <(vars_list) <(files_list))
  echo "mcp-secrets: moved $n, skipped $skipped" >&2
}

cmd_migrate_accessible() {
  echo "mcp-secrets: switching existing items to kSecAttrAccessibleAfterFirstUnlock" >&2
  local name tmp n=0
  # The value goes through a file rather than $(...): command substitution strips
  # trailing newlines, and the first version of this migration cost file secrets
  # (json keys) their last byte.
  tmp=$(mktemp "${TMPDIR:-/tmp}/mcp-secrets-migrate.XXXXXX") || die "cannot create a temporary file"
  chmod 600 "$tmp"
  trap 'rm -f "$tmp"' EXIT
  while read -r name; do
    [ -n "$name" ] || continue
    if ! ( umask 077; "$KC" get "$name" > "$tmp" ) || [ ! -s "$tmp" ]; then
      echo "  $name — not found, skipped" >&2; continue
    fi
    "$KC" delete "$name" >/dev/null 2>&1 || die "$name: cannot delete before re-creating"
    if ! "$KC" set "$name" < "$tmp" >/dev/null 2>&1; then
      # The item is already deleted and the value only lives in the temporary
      # file — do not clean it up, or the secret is gone for good.
      trap - EXIT
      die "$name: cannot re-create; the value is in $tmp, restore it by hand: $KC set $name < $tmp"
    fi
    if "$KC" get "$name" | cmp -s - "$tmp"; then
      echo "  $name — rewritten" >&2
      n=$((n+1))
    else
      trap - EXIT
      die "$name: value mismatch after the migration! the original is in $tmp"
    fi
  done < <(cat <(vars_list) <(files_list))
  rm -f "$tmp"
  trap - EXIT
  echo "mcp-secrets: rewritten $n" >&2
}

usage() {
  cat >&2 <<'EOF'
mcp-secrets — MCP server secrets in the iCloud keychain (service: claude-mcp)

  mcp-secrets list                 what is configured (no values)
  mcp-secrets check                verify everything is readable
  mcp-secrets get NAME             print a value
  mcp-secrets set VAR              write/update (input hidden)
  mcp-secrets delete NAME          delete an item
  mcp-secrets export               export lines for eval
  mcp-secrets load                 (shell function) load into the current shell

File secrets (json keys, OAuth tokens):
  mcp-secrets set-file NAME FILE       put a file into the keychain
  mcp-secrets get-file NAME [OUTFILE]  read it back (to a 0600 file or stdout)

  mcp-secrets migrate-from-login   one-off move from the file-based login.keychain
  mcp-secrets migrate-accessible   one-off switch of items to AfterFirstUnlock

Name lists: ~/.config/mcp-secrets/vars, ~/.config/mcp-secrets/files
Items are synchronized between Macs through the iCloud keychain.
EOF
}

case "${1:-}" in
  list)         shift; cmd_list "$@" ;;
  check)        shift; cmd_check "$@" ;;
  get)          shift; cmd_get "$@" ;;
  set)          shift; cmd_set "$@" ;;
  delete|rm)    shift; cmd_delete "$@" ;;
  export)       shift; cmd_export "$@" ;;
  set-file)     shift; cmd_set_file "$@" ;;
  get-file)     shift; cmd_get_file "$@" ;;
  migrate-from-login) shift; cmd_migrate "$@" ;;
  migrate-accessible) shift; cmd_migrate_accessible "$@" ;;
  load)         die "'load' only works as a shell function from ~/.bash_profile or ~/.zshrc" ;;
  ""|help|-h|--help) usage; [ -z "${1:-}" ] && exit 1 || exit 0 ;;
  *)            die "unknown command: $1 (see mcp-secrets help)" ;;
esac
